# Copy to the php-admin document root as `.htaccess`.

# ---- Force HTTPS (belt + braces; cPanel's "Force HTTPS Redirect" is primary)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---- Block indexing of the admin panel
Header always set X-Robots-Tag "noindex, nofollow, noarchive"

# ---- Security headers
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

# ---- Deny direct access to sensitive files
<FilesMatch "\.(env|ini|log|sql|md)$">
    Require all denied
</FilesMatch>

# ---- Deny access to helper directories
RedirectMatch 404 ^/includes/.*$
RedirectMatch 404 ^/bin/.*$
RedirectMatch 404 ^/deploy/.*$
