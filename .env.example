# Copy to .env.local and populate.

# ---------- MySQL (Namecheap cPanel) ----------
# Create the DB + user in cPanel → MySQL Databases.
# Add Vercel's outbound IPs to cPanel → Remote MySQL (or a wildcard for the
# Vercel region if your plan allows), otherwise all connections will time out.
MYSQL_HOST="your-cpanel-host.example.com"
MYSQL_PORT="3306"
MYSQL_DATABASE="cpuser_kglrealty"
MYSQL_USER="cpuser_kgl_app"
MYSQL_PASSWORD=""
# Set to "true" only if the host terminates TLS on 3306 (stock cPanel does not).
MYSQL_SSL="false"

# ---------- Anthropic / AI Concierge ----------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL_DEFAULT="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_ESCALATED="claude-sonnet-4-6"

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_..."
LEAD_NOTIFY_EMAIL="leads@kglrealtypro.com"
LEAD_FROM_EMAIL="concierge@kglrealtypro.com"

# ---------- WhatsApp (duty-agent deep-link) ----------
WHATSAPP_DUTY_AGENT_NUMBER="+2347038141774"

# ---------- Cloudflare Turnstile ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://kglrealtypro.com"
